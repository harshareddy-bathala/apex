# =====================================================
# Student-Mentor Backend Environment Variables
# =====================================================

# =====================================================
# REQUIRED: MongoDB Configuration (For User Data)
# =====================================================
# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://studentmentor:yourpassword@student-mentor-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name
DATABASE_NAME=student_mentor

# =====================================================
# REQUIRED: Google AI (Gemini) Configuration
# =====================================================
# Your Google AI API key for Gemini models
GOOGLE_API_KEY=your-gemini-api-key-here

# =====================================================
# REQUIRED: Firebase/Google Cloud Credentials
# =====================================================
# Path to your Firebase service account JSON file
# This should be the absolute path to the downloaded service account key
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\your\service-account.json

# Your Google Cloud Project ID (same as Firebase project ID)
FIRESTORE_PROJECT_ID=your-gcp-project-id

# =====================================================
# OPTIONAL: Firebase Configuration
# =====================================================
# Firebase Web API key (from Firebase Console -> Project Settings -> General -> Web API Key)
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Firebase Project ID (usually same as FIRESTORE_PROJECT_ID)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: Different Firebase credentials file (if different from GOOGLE_APPLICATION_CREDENTIALS)
# FIREBASE_CREDENTIALS_FILE=C:\path\to\firebase-service-account.json

# =====================================================
# OPTIONAL: AI Model Configuration
# =====================================================
# Gemini model to use (default: gemini-1.5-flash)
# Available models: gemini-1.5-flash, gemini-1.5-pro, etc.
GEMINI_MODEL=gemini-1.5-flash

# =====================================================
# OPTIONAL: AI Temperature (Advanced)
# =====================================================
# Controls randomness in AI responses (0.0 = deterministic, 1.0 = creative)
ADK_TEMPERATURE=0.0

# =====================================================
# SETUP INSTRUCTIONS
# =====================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values with your actual credentials
# 3. NEVER commit .env file to version control
# 4. Service account needs: Firebase Admin, Firestore, IAM permissions
# =====================================================